# Backend API URL (Môi trường phát triển cục bộ)
VITE_API_URL=http://localhost:5141
VITE_MAPTILER_KEY=API_KEY

# Cấu hình bảo mật mã QR Cột đèn (Citizen QR Security)
VITE_QR_SECRET_KEY=KEY
VITE_QR_MAGIC_PREFIX=PREFIX

# Thời gian tự động xóa bản nháp báo cáo trong IndexedDB (tính theo ngày)
VITE_DRAFT_TTL_DAYS=NUMBER